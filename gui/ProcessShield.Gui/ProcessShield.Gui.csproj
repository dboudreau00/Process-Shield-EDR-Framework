<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ProcessShield.Gui</AssemblyName>
    <RootNamespace>ProcessShield.Gui</RootNamespace>
    <!-- Requests administrator rights at launch (UAC), needed for ETW + process access. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\shield.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reuse the whole detection/response/telemetry/config core from the console app. -->
    <ProjectReference Include="..\..\ProcessShield.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Brand assets (shield + matrix), embedded so the window icon and sidebar logo
         resolve via pack:// URIs. -->
    <Resource Include="Assets\shield.ico" />
    <Resource Include="Assets\shield_256.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ship the sample config alongside the GUI so Settings can load/save it. -->
    <None Include="..\..\shield.config.json" Link="shield.config.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
