<UserControl x:Class="ProcessShield.Gui.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <Style x:Key="Cell.Data" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Font.Data}"/>
            <Setter Property="FontSize" Value="{StaticResource Size.Data}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Cell.Faint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Brush.Faint}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="StatDot" TargetType="Border">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Background" Value="{StaticResource Brush.Safe}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusLevel}" Value="watch">
                    <Setter Property="Background" Value="{StaticResource Brush.Watch}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusLevel}" Value="threat">
                    <Setter Property="Background" Value="{StaticResource Brush.Threat}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="26,24,26,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Problem banner (visible only when the engine can't run) -->
        <Border Grid.Row="0" Margin="0,0,0,12" CornerRadius="8" Padding="14,11"
                Background="#2A1A20" BorderBrush="{StaticResource Brush.Threat}" BorderThickness="1"
                Visibility="{Binding HasProblem, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <Border Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center" Margin="0,0,12,0"
                        Background="{StaticResource Brush.Threat}"/>
                <TextBlock Text="{Binding ProblemText}" TextWrapping="Wrap" VerticalAlignment="Center"
                           Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Paper}"/>
            </StackPanel>
        </Border>

        <!-- Posture ribbon -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Border Style="{StaticResource StatDot}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <StackPanel>
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Display}"/>
                        <TextBlock Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Mist}" Margin="0,3,0,0">
                            <Run Text="Monitors:"/>
                            <Run Text="{Binding Monitors, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding LastMessage}" VerticalAlignment="Center"
                           MaxWidth="360" TextTrimming="CharacterEllipsis"
                           FontFamily="{StaticResource Font.Data}" FontSize="12"
                           Foreground="{StaticResource Brush.Faint}"/>
            </Grid>
        </Border>

        <!-- Stat cards -->
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="CONTAINED" Style="{StaticResource Text.Label}"/>
                    <TextBlock Text="{Binding ContainedCount}" FontFamily="{StaticResource Font.Data}"
                               FontSize="30" Margin="0,6,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource Brush.Threat}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ContainedCount}" Value="0">
                                        <Setter Property="Foreground" Value="{StaticResource Brush.Mist}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,8,0">
                <StackPanel>
                    <TextBlock Text="FLAGGED" Style="{StaticResource Text.Label}"/>
                    <TextBlock Text="{Binding FlaggedCount}" FontFamily="{StaticResource Font.Data}"
                               FontSize="30" Margin="0,6,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource Brush.Watch}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FlaggedCount}" Value="0">
                                        <Setter Property="Foreground" Value="{StaticResource Brush.Mist}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="EVENTS" Style="{StaticResource Text.Label}"/>
                    <TextBlock Text="{Binding Events.Count}" FontFamily="{StaticResource Font.Data}"
                               FontSize="30" Foreground="{StaticResource Brush.Paper}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Threats table + details/actions -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <!-- Table -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0" Margin="0,0,16,0">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="18,16,18,10">
                        <TextBlock Text="Contained &amp; flagged processes" Style="{StaticResource Text.Title}"/>
                        <Button Content="Refresh" HorizontalAlignment="Right" Padding="12,6"
                                Style="{StaticResource Btn.Subtle}" Command="{Binding RefreshCommand}"/>
                    </Grid>
                    <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource Brush.LineSoft}"/>
                    <Grid>
                        <DataGrid ItemsSource="{Binding Threats}"
                                  SelectedItem="{Binding SelectedThreat, Mode=TwoWay}"
                                  Style="{StaticResource Grid.Base}" Margin="6,4,6,6">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="14">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Width="4" CornerRadius="2" Margin="6,7" HorizontalAlignment="Left">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource Brush.Watch}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Severity}" Value="threat">
                                                                <Setter Property="Background" Value="{StaticResource Brush.Threat}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Severity}" Value="safe">
                                                                <Setter Property="Background" Value="{StaticResource Brush.Safe}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="72"
                                                    ElementStyle="{StaticResource Cell.Data}"/>
                                <DataGridTextColumn Header="PROCESS" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="SCORE" Binding="{Binding Score}" Width="82"
                                                    ElementStyle="{StaticResource Cell.Data}"/>
                                <DataGridTextColumn Header="STATE" Binding="{Binding State}" Width="120"/>
                                <DataGridTextColumn Header="TRUST" Binding="{Binding Trust}" Width="86"
                                                    ElementStyle="{StaticResource Cell.Faint}"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Text="Nothing flagged yet. ProcessShield is watching.">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
                                    <Setter Property="Foreground" Value="{StaticResource Brush.Faint}"/>
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Threats.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Details / actions -->
            <Border Grid.Column="1" Style="{StaticResource Card}">
                <Grid>
                    <!-- Empty state -->
                    <TextBlock VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                               Text="Select a process to review why it was flagged and take action."
                               Foreground="{StaticResource Brush.Faint}" Style="{StaticResource Text.Body}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
                                <Setter Property="Foreground" Value="{StaticResource Brush.Faint}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelection}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Detail -->
                    <DockPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}"
                               DataContext="{Binding SelectedThreat}">
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Title}" TextTrimming="CharacterEllipsis"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Style="{StaticResource Text.Data}" Foreground="{StaticResource Brush.Mist}">
                                    <Run Text="pid"/><Run Text="{Binding Pid, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding State}" Style="{StaticResource Text.Body}"
                                           Foreground="{StaticResource Brush.Mist}" Margin="14,0,0,0"/>
                                <TextBlock Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Mist}" Margin="14,0,0,0">
                                    <Run Text="score"/><Run Text="{Binding Score, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                            <TextBlock Text="{Binding ImagePath}" Style="{StaticResource Text.Body}"
                                       Foreground="{StaticResource Brush.Faint}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                            <Border Height="1" Background="{StaticResource Brush.LineSoft}" Margin="0,14"/>
                            <TextBlock Text="WHY IT FLAGGED" Style="{StaticResource Text.Label}"/>
                        </StackPanel>

                        <!-- Actions pinned to the bottom -->
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
                            <Button Content="Release (resume)" Style="{StaticResource Btn.Primary}"
                                    Command="{Binding DataContext.ReleaseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            <Button Content="Suspend" Style="{StaticResource Btn.Subtle}" Margin="0,8,0,0"
                                    Command="{Binding DataContext.SuspendCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            <Button Content="End process" Style="{StaticResource Btn.Danger}" Margin="0,8,0,0"
                                    Command="{Binding DataContext.EndCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        </StackPanel>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                            <ItemsControl ItemsSource="{Binding Reasons}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,7"
                                                   Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Mist}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
