<UserControl x:Class="ProcessShield.Gui.Views.EventsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <!-- Coloured severity dot for a feed row -->
        <Style x:Key="EventDot" TargetType="Border">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{StaticResource Brush.Faint}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="QUARANTINE">
                    <Setter Property="Background" Value="{StaticResource Brush.Threat}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="WARN">
                    <Setter Property="Background" Value="{StaticResource Brush.Watch}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="ACTION">
                    <Setter Property="Background" Value="{StaticResource Brush.Info}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="26,24,26,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="Live events" Style="{StaticResource Text.Display}"/>
                <TextBlock Text="Warnings, containments, and analyst actions as they happen"
                           Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Mist}" Margin="0,3,0,0"/>
            </StackPanel>
            <Button Content="Clear" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Style="{StaticResource Btn.Subtle}" Command="{Binding ClearEventsCommand}"/>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="6">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Events}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,9" Margin="2,1" CornerRadius="6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="86"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Style="{StaticResource EventDot}" Margin="2,0,12,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Time}" VerticalAlignment="Center"
                                                   FontFamily="{StaticResource Font.Data}" FontSize="12"
                                                   Foreground="{StaticResource Brush.Faint}" Margin="0,0,14,0"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Level}" VerticalAlignment="Center"
                                                   Style="{StaticResource Text.Label}"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Text}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Paper}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                           Text="No events yet." Foreground="{StaticResource Brush.Faint}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
                            <Setter Property="Foreground" Value="{StaticResource Brush.Faint}"/>
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Events.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</UserControl>
